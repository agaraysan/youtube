x0, x1, y0, y1 = 205, 818, 307, 1228
band = output[y0:y1, x0:x1].astype(np.float32)
offset = np.zeros_like(band)
weight_sum = np.zeros(band.shape[:2], dtype=np.float32)
width = 24
for side, reference, edge in [
    ('top', source[y0-1, x0:x1], band[0]),
    ('bottom', source[y1, x0:x1], band[-1]),
    ('left', source[y0:y1, x0-1], band[:, 0]),
    ('right', source[y0:y1, x1], band[:, -1]),
]:
    delta = reference.astype(np.float32) - edge
