import numpy as np
p='tmp_art/zoom130/'
src=np.asarray(Image.open(p+'loop_canvas.png'))
out=np.array(Image.open(p+'loop_raw_2.png'))
base=out.astype(float)
for side in ('left','right','top','bottom'):
    horizontal=side in ('left','right')
    a,b=(base,src) if horizontal else (base.transpose(1,0,2),src.transpose(1,0,2))
    start,end,edge,sign={'left':(307,1228,205,1),'right':(307,1228,817,-1),'top':(205,818,307,1),'bottom':(205,818,1227,-1)}[side]
    delta=b[start:end,np.arange(edge-sign,edge-sign*7,-sign)].mean(axis=1)-a[start:end,np.arange(edge,edge+sign*6,sign)].mean(axis=1)
    kernel=np.exp(-0.5*(np.arange(-9,10)/3)**2)
    delta=np.clip(np.stack([np.convolve(c,kernel/kernel.sum(),mode='same') for c in delta.T],axis=1),-22,22)
    dest=out if horizontal else out.transpose(1,0,2)
    for i in range(28):
        x=edge+sign*i
        dest[start:end,x]=np.clip(dest[start:end,x]+delta*(1-i/28)**2,0,255).round()
Image.fromarray(out).save(p+'loop_raw_2.png')
