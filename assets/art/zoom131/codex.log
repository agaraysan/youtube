target_y, source_y = (0, 512, 1024, 1536), (0, 535, 1024, 1536)
mesh = []
for row in range(3):
    for col in range(3):
        if row == col == 1:
            continue
        left, right = source_x[col:col+2]
        top, bottom = source_y[row:row+2]
        box = (target_x[col], target_y[row], target_x[col+1], target_y[row+1])
