aperture = (341, 512, 682, 1024)
result.paste(original.crop(aperture), aperture)
path = folder / 'raw_04_0.png'
result.save(path)
with Image.open(path) as saved:
    assert saved.size == original.size and saved.format == 'PNG'
    assert ImageChops.difference(saved.crop(aperture), original.crop(aperture)).getbbox() is None
