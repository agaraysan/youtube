from PIL import Image
import numpy as np
p='tmp_art/zoom132/'
s=np.array(Image.open(p+'loop_canvas.png'),dtype=np.float32)
g=np.array(Image.open(p+'loop_raw_0.png'),dtype=np.float32)
for axis,start,stop,lo,hi in [(0,307,1228,205,818),(1,205,818,307,1228)]:
    b=g.swapaxes(0,axis)
    original=s.swapaxes(0,axis)
    for edge,step in [(start,1),(stop-1,-1)]:
        delta=original[edge-step,lo:hi]-b[edge,lo:hi]
        padded=np.pad(delta,((2,2),(0,0)),mode='edge')
        delta=sum(w*padded[i:i+hi-lo] for i,w in enumerate([1,4,6,4,1]))/16
        for d in range(36):
            b[edge+d*step,lo:hi]+=delta*(1-d/36)**2
mask=np.zeros(s.shape[:2],dtype=bool)
mask[307:1228,205:818]=True
mask[512:1024,341:682]=False
g[~mask]=s[~mask]
Image.fromarray(np.clip(np.rint(g),0,255).astype('uint8')).save(p+'loop_raw_0.png')
with Image.open(p+'loop_raw_0.png') as saved:
    assert saved.size==(1024,1536) and saved.format=='PNG'
    pixels=np.array(saved)
    assert np.array_equal(pixels[~mask],s[~mask])
    assert not np.any(np.all(pixels[mask]==128,axis=1))
print('Verified final PNG and preserved pixels.')
