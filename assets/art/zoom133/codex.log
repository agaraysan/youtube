with Image.open('/home/runner/.codex/generated_images/01a1ee1d-21f7-7ad0-8f70-3403d2cc8deb/exec-b77d8895-e88e-4526-8d61-d228a1ef0623.png') as generated, Image.open(p/'canvas_03.png') as original:
