# Register the generated jambs to the preserved aperture, reducing the
# adjustment to zero before reaching the outer edge of the fill.
def register(points, source, count):
    return np.interp(np.arange(count)+0.5, points, source)-0.5
xs = register([0, 255, 341, 682, 768, 1024], [0, 255, 343, 678, 768, 1024], 1024)
ys = register([0, 420, 512, 1024, 1100, 1536], [0, 420, 510, 1024, 1100, 1536], 1536)
layer = np.asarray(generated)
