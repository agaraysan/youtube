from PIL import Image, ImageChops, ImageFilter
from pathlib import Path
root=Path('tmp_art/zoom136')
original=Image.open(root/'loop_canvas.png')
path=root/'loop_raw_1.png'
result=Image.open(path).copy()
edges=[
    (original.crop((205,306,818,307)),result.crop((205,307,818,308)),lambda i:(205,307+i),False,14),
    (original.crop((205,1228,818,1229)),result.crop((205,1227,818,1228)),lambda i:(205,1227-i),False,15),
    (original.crop((204,307,205,1228)),result.crop((205,307,206,1228)),lambda i:(205+i,307),True,12),
    (original.crop((818,307,819,1228)),result.crop((817,307,818,1228)),lambda i:(817-i,307),True,12),
]
for reference, current, position, vertical, width in edges:
    reference=list(reference.filter(ImageFilter.GaussianBlur(1)).getdata())
    current=list(current.filter(ImageFilter.GaussianBlur(1)).getdata())
    for offset in range(width):
        x,y=position(offset)
        length=len(reference)
        box=(x,y,x+(1 if vertical else length),y+(length if vertical else 1))
        strip=result.crop(box)
        corrected=[]
        for index,(pixel,target,source) in enumerate(zip(strip.getdata(),reference,current)):
            corner_weight=min(1,index/width,(length-1-index)/width) if vertical else 1
            weight=0.8*(1-offset/width)**2*corner_weight
            corrected.append(tuple(max(0,min(255,round(value+weight*(dest-start)))) for value,dest,start in zip(pixel,target,source)))
        strip.putdata(corrected)
        result.paste(strip,(x,y))
result.save(path)
saved=Image.open(path)
assert saved.size==(1024,1536) and saved.format=='PNG'
diff=ImageChops.difference(original,saved)
assert diff.getbbox()==(205,307,818,1228)
assert diff.crop((341,512,682,1024)).getbbox() is None
print('Verified PNG dimensions and exact preservation outside the gray ring.')
