from PIL import Image, ImageChops
import sys
from pathlib import Path
folder = Path('tmp_art/zoom137')
original = Image.open(folder / 'canvas_02.png').convert('RGB')
painted = Image.open(sys.argv[1]).convert('RGB')
assert original.size == painted.size == (1024, 1536)
bounds = (341, 512, 682, 1024)
source_x, target_x = (0, 343, 681, 1024), (0, 341, 682, 1024)
source_y, target_y = (0, 547, 1058, 1536), (0, 512, 1024, 1536)
out = Image.new('RGB', original.size)
for i in range(3):
    for j in range(3):
        region = painted.crop((source_x[i], source_y[j], source_x[i+1], source_y[j+1]))
        size = (target_x[i+1]-target_x[i], target_y[j+1]-target_y[j])
        out.paste(region.resize(size, Image.Resampling.LANCZOS), (target_x[i], target_y[j]))
out.paste(original.crop(bounds), bounds[:2])
dest = folder / 'raw_02_0.png'
out.save(dest)
with Image.open(dest) as saved:
    assert saved.size == (1024, 1536)
    assert ImageChops.difference(saved.crop(bounds), original.crop(bounds)).getbbox() is None
    print('PNG size and exact central pixels verified')
