require 'zlib'
require 'json'
def readpng(path)
 s=File.binread(path); pos=8; dat=''.b
 while pos<s.bytesize
 n=s[pos,4].unpack1('N'); t=s[pos+4,4]; d=s[pos+8,n]; pos+=n+12
 if t=='IHDR'; @w,@h,depth,col=d.unpack('NNCC'); raise unless depth==8 && [2,6].include?(col); @c=col==2 ? 3 : 4; end
 dat<<d if t=='IDAT'
 end
 raw=Zlib::Inflate.inflate(dat); stride=@w*@c; rows=[]; prev=Array.new(stride,0); off=0
 @h.times do
 f=raw.getbyte(off); off+=1; row=raw[off,stride].bytes; off+=stride
 stride.times do |i|
 a=i>=@c ? row[i-@c] : 0; b=prev[i]; c=i>=@c ? prev[i-@c] : 0
 v=case f; when 0 then 0; when 1 then a; when 2 then b; when 3 then (a+b)/2; when 4 then p=a+b-c; pa=(p-a).abs; pb=(p-b).abs; pc=(p-c).abs; pa<=pb && pa<=pc ? a : pb<=pc ? b : c; end
 row[i]=(row[i]+v)&255
 end
 rows<<row; prev=row
 end
 w=@w; h=@h; ch=@c
 Array.new(1024) do |y|
 sy=(y+0.5)*h/1024.0-0.5; y0=[sy.floor,0].max; y1=[y0+1,h-1].min; fy=[sy-y0,0].max
 Array.new(1024*3) do |i|
 x=i/3; k=i%3; sx=(x+0.5)*w/1024.0-0.5; x0=[sx.floor,0].max; x1=[x0+1,w-1].min; fx=[sx-x0,0].max
 ((rows[y0][x0*ch+k]*(1-fx)+rows[y0][x1*ch+k]*fx)*(1-fy)+(rows[y1][x0*ch+k]*(1-fx)+rows[y1][x1*ch+k]*fx)*fy).round
 end
 end
end
def savepng(path,rows)
 chunk=->(t,d){[d.bytesize].pack('N')+t+d+[Zlib.crc32(t+d)].pack('N')}
