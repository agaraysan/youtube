src = Path('/home/runner/.codex/generated_images/01a1eddc-4762-7042-a560-2cb23dcfe442')
base, edit1, edit2 = [Image.open(next(src.glob('exec-'+prefix+'*.png'))).convert('RGB') for prefix in ('bd21399c','479ccb29','2dd36d8b')]
print(base.size,edit1.size,edit2.size)
out = Path('assets/generated/spotW05_01')
patches = [
(edit2,(271,121,375,242),'形','木の巣箱が樽の形になっている'),
(edit1,(1109,201,1209,372),'消失','枝からつるされた編みかごのボールが消えている'),
(edit1,(619,480,729,599),'入れ替え','ベンチのリュックが野菜とパンの入った紙袋に替わっている'),
(edit1,(73,851,153,1059),'大きさ','赤いマグの横の銀色の水筒が短くなっている'),
(edit2,(1022,845,1099,933),'数','プールの黄色いアヒルのおもちゃが1羽増えている')]
composite = base.copy()
for edit, box, _, _ in patches:
    x0,y0,x1,y1 = box
    mask = Image.new('L',(x1-x0,y1-y0))
    ImageDraw.Draw(mask).rectangle((5,5,x1-x0-6,y1-y0-6), fill=255)
    mask = mask.filter(ImageFilter.GaussianBlur(2))
    composite.paste(edit.crop(box),(x0,y0),mask)
a,b = [im.resize((1024,1024),Image.Resampling.LANCZOS) for im in (base,composite)]
diff = ImageChops.difference(a,b)
regions=[]
for _,box,typ,description in patches:
    roi = tuple(round(v*1024/base.width)+(-5 if i<2 else 5) for i,v in enumerate(box))
    bounds = diff.crop(roi).getbbox()
    x,y,r,bottom = [v+roi[i%2] for i,v in enumerate(bounds)]
    assert max(r-x,bottom-y)>=50
    regions.append(dict(description=description,type=typ,x=x,y=y,width=r-x,height=bottom-y))
remaining = diff.copy()
for i,p in enumerate(regions):
    for q in regions[:i]:
        dx=max(p['x']-(q['x']+q['width']),q['x']-(p['x']+p['width']),0)
        dy=max(p['y']-(q['y']+q['height']),q['y']-(p['y']+p['height']),0)
