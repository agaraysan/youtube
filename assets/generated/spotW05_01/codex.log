    x,y,w,h=(p[k] for k in ('x','y','width','height'))
    remaining.paste((0,0,0),(x,y,x+w,y+h))
assert remaining.getbbox() is None
a.save(out/'a.png')
b.save(out/'b.png')
for name, data in [('differences.json',dict(differences=regions)),('result.json',dict(id='spotW05_01',status='ok',via='codex-cloud',files=['a.png','b.png','differences.json']))]:
