from itertools import combinations
from math import hypot
p=Path('assets/generated/spotW05_02')
assert {f.name for f in p.iterdir()}=={'a.png','b.png','differences.json','result.json'}
a,b=(Image.open(p/f) for f in ('a.png','b.png'))
assert a.format==b.format=='PNG' and a.size==b.size==(1024,1024)
diff=ImageChops.difference(a,b)
items=json.loads((p/'differences.json').read_text())['differences']
assert len(items)==len({d['type'] for d in items})==5
for d in items:
    x,y,w,h=(d[k] for k in ('x','y','width','height'))
    assert max(w,h)>=50 and min(x,y,1024-x-w,1024-y-h)>0
    box=(x,y,x+w,y+h)
    assert diff.crop(box).getbbox()==(0,0,w,h)
    ImageDraw.Draw(diff).rectangle((x,y,x+w-1,y+h-1),fill=(0,0,0))
assert diff.getbbox() is None
for u,v in combinations(items,2):
    assert hypot(max(u['x']-v['x']-v['width'],v['x']-u['x']-u['width'],0),max(u['y']-v['y']-v['height'],v['y']-u['y']-u['height'],0))>=200
assert json.loads((p/'result.json').read_text())==dict(id=p.name,status='ok',via='codex-cloud',files=['a.png','b.png','differences.json'])
print('Verified PNG dimensions, five exact boxes, spacing and pixel identity outside the boxes.')
