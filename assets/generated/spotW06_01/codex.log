from PIL import Image, ImageDraw, ImageFilter, ImageChops
from pathlib import Path
import json, math, itertools, sys

out = Path('assets/generated/spotW06_01')
a = Image.open('/tmp/spotW06_01-a.png').convert('RGB')
source = Image.open(sys.argv[1]).convert('RGB')
assert source.size == (1254,1254)
edited = source.resize(a.size, Image.Resampling.LANCZOS)
targets = [
    ('左上の棚から黒い鉄瓶が消えている', '消失', [(117,17),(147,10),(182,9),(218,22),(228,56),(229,72),(242,92),(245,130),(233,148),(122,150),(119,134),(116,100),(126,72),(129,43)]),
    ('右上の棚の丸みのあるつぼが角ばった形になっている', '形', [(1038,40),(1055,22),(1112,21),(1137,38),(1135,94),(1129,106),(1043,108),(1038,90)]),
    ('薄緑の皿の巻きずしが3個から2個に減っている', '数', [(678,491),(687,475),(707,470),(751,472),(775,474),(784,487),(779,514),(768,528),(684,530),(679,518)]),
    ('ふた付きの容器の青い縦じまが水玉模様になっている', '模様', [(193,693),(221,676),(228,663),(273,663),(276,676),(308,686),(317,703),(326,750),(329,768),(319,795),(321,823),(305,834),(299,829),(249,814),(192,814),(188,799),(187,745)]),
    ('青い模様の小鉢のガリが輪切りのきゅうりに変わっている', '入れ替え', [(673,973),(686,948),(706,942),(722,948),(742,954),(774,956),(800,963),(814,987),(822,1006),(810,1018),(776,1027),(708,1025),(685,1017),(675,1008)])
]
b = a.copy()
records = []
for description, kind, outline in targets:
    hard = Image.new('L', a.size)
    ImageDraw.Draw(hard).polygon([(round(x*1024/1254),round(y*1024/1254)) for x,y in outline],fill=255)
    blurred = hard.filter(ImageFilter.GaussianBlur(3))
    mask = blurred.point(lambda p: max(0, min(255, round((p-2)*255/251))))
    patch = Image.composite(edited,a,mask)
    affected = ImageChops.difference(patch,a).getbbox()
    assert affected is not None
    x,y,r,d = affected
    b.paste(patch.crop(affected),(x,y))
    records.append(dict(description=description,type=kind,x=x,y=y,width=r-x,height=d-y))

a.save(out/'a.png')
b.save(out/'b.png')
(out/'differences.json').write_text(json.dumps(dict(differences=records),ensure_ascii=False,indent=2)+'\\n')
(out/'result.json').write_text(json.dumps(dict(id='spotW06_01',status='ok',via='codex-cloud',files=['a.png','b.png','differences.json']),indent=2)+'\\n')
preview = Image.new('RGB',(1024,1024))
preview.paste(a.resize((512,512)),(0,0))
preview.paste(b.resize((512,512)),(512,0))
for i, row in enumerate(records):
    x,y,w,h = (row[key] for key in ('x','y','width','height'))
    box=(x-5,y-5,x+w+5,y+h+5)
    top=515 if i<3 else 685
    left=(i if i<3 else i-3)*340
    preview.paste(a.crop(box),(left,top))
    preview.paste(b.crop(box),(left+160,top))
preview.crop((0,0,1024,840)).save('/tmp/spotW06_01-preview.png')
