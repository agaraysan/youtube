/bin/bash -lc "python - <<'PY'
from PIL import Image, ImageChops, ImageDraw
from pathlib import Path
from itertools import combinations
from math import hypot
import json
p=Path('assets/generated/spotW06_01')
a,b=[Image.open(p/name) for name in ('a.png','b.png')]
assert a.size == b.size == (1024,1024)
assert a.mode == b.mode == 'RGB'
diff=ImageChops.difference(a,b)
rows=json.loads((p/'differences.json').read_text())['differences']
assert len(rows)==len({row['type'] for row in rows})==5
outside=diff.copy()
boxes=[]
for row in rows:
    x,y,w,h=(row[k] for k in ('x','y','width','height'))
    box=(x,y,x+w,y+h)
    assert min(x,y,1024-x-w,1024-y-h)>0 and max(w,h)>=50
    assert diff.crop(box).getbbox()==(0,0,w,h)
    ImageDraw.Draw(outside).rectangle((x,y,x+w-1,y+h-1),fill=(0,0,0))
    boxes.append(box)
assert outside.getbbox() is None
gap=min(hypot(max(0,a[0]-b[2],b[0]-a[2]),max(0,a[1]-b[3],b[1]-a[3])) for a,b in combinations(boxes,2))
assert gap>=200
result=json.loads((p/'result.json').read_text())
assert set(result['files']+['result.json'])=={f.name for f in p.iterdir()}
print(f'1024×1024、差分5か所、最小間隔 {gap:.1f} px、差分範囲外 0 px')
