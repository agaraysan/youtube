]
out=Path('assets/generated/spotW07_05')
out.mkdir(parents=True,exist_ok=True)
size=(1024,1024)
a=base.resize(size,Image.Resampling.LANCZOS)
candidate=edited.resize(size,Image.Resampling.LANCZOS)
b=a.copy()
diffs=[]
for kind,description,polygon,blur in regions:
    mask=Image.new('L',base.size)
    ImageDraw.Draw(mask).polygon(polygon,fill=255)
    mask=mask.filter(ImageFilter.GaussianBlur(blur)).resize(size,Image.Resampling.LANCZOS)
    mask=mask.point(lambda v: 0 if v < 5 else v)
    patch=Image.composite(candidate,a,mask)
    bbox=ImageChops.difference(a,patch).getbbox()
    x,y,r,d=bbox
    b.paste(patch.crop(bbox),(x,y))
    diffs.append(dict(description=description,type=kind,x=x,y=y,width=r-x,height=d-y))

coverage=Image.new('L',size)
draw=ImageDraw.Draw(coverage)
for item in diffs:
    x,y,w,h=(item[k] for k in ('x','y','width','height'))
    assert max(w,h)>=50 and min(x,y,1024-x-w,1024-y-h)>=0
    draw.rectangle((x,y,x+w-1,y+h-1),fill=255)
for first,second in combinations(diffs,2):
    def center(d): return (d['x']+d['width']/2,d['y']+d['height']/2)
    ax,ay=center(first)
    bx,by=center(second)
    assert hypot(ax-bx,ay-by)>=200
delta=ImageChops.difference(a,b)
assert all(ImageChops.multiply(c,ImageChops.invert(coverage)).getbbox() is None for c in delta.split())
for name,pic in [('a.png',a),('b.png',b)]:
