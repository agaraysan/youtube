from PIL import Image, ImageDraw, ImageFilter, ImageChops
from pathlib import Path
from itertools import combinations
from math import hypot
import json

root = Path('/home/runner/.codex/generated_images/01a1ee1f-e870-7f32-900a-764ba69bc6fd')
out = Path('assets/generated/spotW08_01')
original = Image.open(root / 'exec-aacb7eef-3b11-49f4-b84a-c05ced0ba281.png').convert('RGB')
edited = Image.open(root / 'exec-f47b90d9-fde7-4939-8386-74d01107deb0.png').convert('RGB')
assert original.size == edited.size == (1254, 1254)
size = (1024, 1024)
base = original.resize(size, Image.Resampling.LANCZOS)
variant = edited.resize(size, Image.Resampling.LANCZOS)
right = base.copy()
regions = [
    ('水中に浮かぶ金色の貝殻が消えている', '消失', (838, 33, 957, 130), 8),
    ('左上のちょうちんの花模様が波模様に変わっている', '模様', (190, 75, 266, 145), 3),
    ('玉手箱の貝殻の留め具が丸い翡翠の飾りに変わっている', '入れ替え', (598, 572, 663, 636), 4),
    ('左下の開いた貝に入っている真珠が大きくなっている', '大きさ', (159, 1031, 257, 1119), 5),
    ('手前の花瓶の胴が丸くふくらんでいる', '形', (689, 947, 867, 1158), 8),
]
differences = []
for description, kind, coords, blur in regions:
    mask = Image.new('L', original.size)
    ImageDraw.Draw(mask).rounded_rectangle(coords, radius=12, fill=255)
    mask = mask.filter(ImageFilter.GaussianBlur(blur)).resize(size, Image.Resampling.LANCZOS)
    patch_result = Image.composite(variant, base, mask)
    box = ImageChops.difference(patch_result, base).getbbox()
    x, y, x2, y2 = box
    assert max(x2-x, y2-y) >= 50 and min(x,y,1024-x2,1024-y2) >= 15
    right.paste(patch_result.crop(box), (x,y))
    differences.append(dict(description=description, type=kind, x=x, y=y, width=x2-x, height=y2-y))

for a,b in combinations(differences,2):
    dx = max(a['x']-b['x']-b['width'], b['x']-a['x']-a['width'], 0)
    dy = max(a['y']-b['y']-b['height'], b['y']-a['y']-a['height'], 0)
    assert hypot(dx,dy) >= 200, (a,b,dx,dy)

for name, image in [('a.png',base),('b.png',right)]:
    image.save(out / name, optimize=True)
for name, data in [
    ('differences.json', dict(differences=differences)),
    ('result.json', dict(id='spotW08_01', status='ok', via='codex-cloud', files=['a.png','b.png','differences.json'])),
]:
    (out/name).write_text(json.dumps(data, ensure_ascii=False, indent=2)+'\\n')

with Image.open(out/'a.png') as a, Image.open(out/'b.png') as b:
    assert a.size == b.size == size
    delta = ImageChops.difference(a,b)
    for entry in differences:
        x,y,w,h = (entry[k] for k in ('x','y','width','height'))
        assert delta.crop((x,y,x+w,y+h)).getbbox() == (0,0,w,h)
        delta.paste((0,0,0),(x,y,x+w,y+h))
    assert delta.getbbox() is None
print((out/'differences.json').read_text())
